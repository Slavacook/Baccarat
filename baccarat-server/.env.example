# ─── Приложение ───
APP_NAME=Baccarat Trainer Server
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# ─── База данных ───
DATABASE_URL=postgresql+asyncpg://baccarat:baccarat@localhost:5432/baccarat_trainer

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── JWT (СГЕНЕРИРУЙТЕ СВОЙ СЕКРЕТ!) ───
JWT_SECRET_KEY=dev-secret-key-change-in-production-to-random-64-char-string!!

# ─── CORS ───
CORS_ORIGINS=["http://localhost:3000"]

# ─── Sentry ───
SENTRY_DSN=

# ─── Push уведомления ───
FCM_SERVER_KEY=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
