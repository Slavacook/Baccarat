DB_PASSWORD=СГЕНЕРИРУЙ_СЛУЧАЙНЫЙ_ПАРОЛЬ_32_СИМВОЛА
DB_NAME=baccarat_trainer

# ─── Redis ───
REDIS_PASSWORD=СГЕНЕРИРУЙ_СЛУЧАЙНЫЙ_ПАРОЛЬ_32_СИМВОЛА

# ─── JWT (СГЕНЕРИРУЙ!) ───
