; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Baccara"
run/main_scene="uid://bfjp1iwsis27p"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://scripts/SaveManager.gd"
Localization_auto="*res://scripts/Localization.gd"
GameModeManager="*res://scripts/GameModeManager.gd"
GameStateManager="*res://scripts/autoload/GameStateManager.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
InputContextManager="*res://scripts/autoload/InputContextManager.gd"
ChanceCardManager="*res://scripts/chance_cards/ChanceCardManager.gd"
StatsManager="*res://scripts/StatsManager.gd"
ToastManager="*res://scripts/ToastManager.gd"
OverlayNotificationManager="*res://scripts/OverlayNotificationManager.gd"
GameDataManager="*res://scripts/GameDataManager.gd"
PayoutSettingsManager="*res://scripts/autoload/PayoutSettingsManager.gd"
BetProfileManager="*res://scripts/autoload/BetProfileManager.gd"
GuestSettingsManager="*res://scripts/autoload/GuestSettingsManager.gd"
GuestStatsManager="*res://scripts/autoload/GuestStatsManager.gd"
PatienceTimerManager="*res://scripts/autoload/PatienceTimerManager.gd"
GuestReturnManager="*res://scripts/autoload/GuestReturnManager.gd"
PayoutContextManager="*res://scripts/PayoutContextManager.gd"
TableStateManager="*res://scripts/autoload/TableStateManager.gd"
KeyboardNavigationController="*res://scripts/KeyboardNavigationController.gd"
KeyboardFocusController="*res://scripts/KeyboardFocusController.gd"
SwipeNavigationController="*res://scripts/SwipeNavigationController.gd"
TestCardsManager="*res://scripts/autoload/TestCardsManager.gd"
FeedbackAnimationManager="*res://scripts/ui/FeedbackAnimationManager.gd"
SoundManager="*res://scripts/SoundManager.gd"

[display]

window/size/viewport_width=1154
window/size/viewport_height=650
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/width=1154
window/size/height=650

[dotnet]

project/assembly_name="Baccara"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

