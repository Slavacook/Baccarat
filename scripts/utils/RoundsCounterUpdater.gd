# res://scripts/utils/RoundsCounterUpdater.gd
# ═══════════════════════════════════════════════════════════════════════════
# ОБНОВЛЯТЕЛЬ СЧЕТЧИКА РАУНДОВ
# 
# Отвечает за:
# - Обновление отображения счетчика раздач
# - Обработку начала новой раздачи
# ═══════════════════════════════════════════════════════════════════════════

class_name RoundsCounterUpdater
extends RefCounted

# ═══════════════════════════════════════════════════════════════════════════
# ЗАВИСИМОСТИ
# ═══════════════════════════════════════════════════════════════════════════

var rounds_counter_label: Label
var rounds_completed_callback: Callable  # Callback для получения количества раундов

# ═══════════════════════════════════════════════════════════════════════════
# ИНИЦИАЛИЗАЦИЯ
# ═══════════════════════════════════════════════════════════════════════════

func _init(label: Label, callback: Callable) -> void:
	"""Инициализировать обновлятель счетчика раундов
	
	Args:
		label: Label для отображения счетчика
		callback: Callback для получения количества завершенных раундов
	"""
	rounds_counter_label = label
	rounds_completed_callback = callback

# ═══════════════════════════════════════════════════════════════════════════
# ПУБЛИЧНЫЕ МЕТОДЫ
# ═══════════════════════════════════════════════════════════════════════════

func on_round_started() -> void:
	"""Обработчик начала новой раздачи (открыты первые 4 карты)"""
	update_counter()

func update_counter() -> void:
	"""Обновить отображение счетчика раздач"""
	if rounds_counter_label and rounds_completed_callback.is_valid():
		var rounds = rounds_completed_callback.call()
		rounds_counter_label.text = "Раздача: %d" % rounds

